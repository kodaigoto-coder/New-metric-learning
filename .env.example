# Environment Configuration Template (.env.example)

# Service URLs (Docker Compose internal DNS defaults on 18000-series ports)
BACKEND_API_URL=http://api-backend:18000
TRAINER_API_URL=http://trainer-service:18001

# Shared Storage Path
DATA_DIR=/app/data

# ML / Trainer Defaults
DEFAULT_BACKBONE=efficientnet_b3
DEFAULT_POOLING=gem
EMBEDDING_DIM=128
DEVICE=cpu

# GCP / GCE Deployment Settings (Unified to us-central1)
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCE_INSTANCE_NAME=metric-learning-vm
GCE_ZONE=us-central1-a
IMAGE_TAG=latest
